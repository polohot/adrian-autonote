# Copy to .env (ignored by Git). podman-compose reads it automatically.

# On a network that inspects TLS (company firewall), point this at the company root
# certificate so the container can reach npm during the build and HTTPS APIs at runtime.
# CORP_CA_FILE=/usr/local/share/ca-certificates/company-root.crt

# Port published on 127.0.0.1 (default 3000).
# PORT=3000
